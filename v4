[string[]]$ips = foreach($a in 0..254){ foreach($b in 1..254){ "192.168.$a.$b" } }
$opt = New-Object System.Threading.Tasks.ParallelOptions -Property @{ MaxDegreeOfParallelism = 1500 }
[System.Threading.Tasks.Parallel]::ForEach($ips, $opt, [Action[string]]{
    param($ip)
    try {
        if ((New-Object Net.NetworkInformation.Ping).Send($ip, 50).Status -eq 'Success') {
            [Console]::WriteLine("[ONLINE] $ip")
        }
    } catch {}
})
